# OmniGrowth environment. Copy to `.env` and fill in secrets. `.env` is git-ignored.
# Every variable the application reads is listed here (spec §25, §40).

# --- runtime -----------------------------------------------------------------
ENV=dev                         # dev | test | prod   (ENV=test forbids PUBLISH_MODE=LIVE)
PUBLISH_MODE=MOCK               # MOCK | MANUAL | LIVE  (LIVE needs the A6 guards + human phrase)
LOG_LEVEL=INFO
LOG_JSON=true

# --- database / queue (ADR-0008: explicit URLs, non-default host ports) --------
POSTGRES_USER=omnigrowth
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=omnigrowth
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
API_HOST_PORT=8000

# Used by tools running on the host (uv run poe migrate / api / tests):
DATABASE_URL=postgresql://omnigrowth:change-me-to-a-long-random-string@127.0.0.1:55432/omnigrowth
REDIS_URL=redis://127.0.0.1:56379/0
DB_POOL_SIZE=10

# --- local LLM (A1: env > preset > error) ---------------------------------------
# Leave OMNIGROWTH_LOCAL_LLM_URL empty to use the preset's host URL from config/models.yaml.
OMNIGROWTH_LOCAL_LLM_PRESET=lmstudio      # lmstudio (decision 2026-09-26: the only routed server)
OMNIGROWTH_LOCAL_LLM_URL=
# Containers use the preset's base_url_docker; set this only to override it inside Docker.
OMNIGROWTH_DOCKER_LLM_URL=
# host | docker (docker-compose sets docker for its services)
OMNIGROWTH_RUNTIME=host
# Where uploaded source files are stored (content-addressed by sha256).
OMNIGROWTH_UPLOAD_DIR=data/uploads
# Directory holding models.yaml etc.
OMNIGROWTH_CONFIG_DIR=config
OMNIGROWTH_ROUTING_PROFILE=LOCAL_ONLY     # LOCAL_ONLY | BALANCED | QUALITY_FIRST
# Max open (QUEUED+RUNNING) jobs per model queue before human requests get 429.
OMNIGROWTH_MAX_OPEN_MODEL_JOBS=20
LLM_HEALTH_TIMEOUT_S=2.0

# --- cloud model (ADR-0002: only this key is ever used; generic SDK vars are ignored) ---
OMNIGROWTH_CLOUD_API_KEY=

# --- tests: optional server for integration tests (defaults to DATABASE_URL) ---------------
INTEGRATION_DATABASE_URL=

# --- credential encryption key for platform credentials (Phase 13) --------------
OMNIGROWTH_CREDENTIAL_KEK=

# --- integrations / n8n (Phase 12; n8n/README.md) ----------------------------------
# Webhooks stay OFF until this is set (>= 32 random characters). Every webhook secret is
# derived from it; changing it invalidates all of them at once.
OMNIGROWTH_WEBHOOK_KEY=
# Local / self-hosted n8n targets as host:port, comma-separated (e.g. localhost:5678,
# [::1]:5678). Public targets must be HTTPS on 443 and are not listed here.
OMNIGROWTH_WEBHOOK_TARGET_ALLOWLIST=
OMNIGROWTH_WEBHOOK_MAX_ATTEMPTS=8
OMNIGROWTH_WEBHOOK_TIMEOUT_S=10
OMNIGROWTH_WEBHOOK_SECRET_GRACE_HOURS=24
# Base URL of the web app, used for links in notifications.
OMNIGROWTH_APP_URL=http://127.0.0.1:5173
